<?xml version="1.0" encoding="utf-8"?>
<!--
  The circular flare that sits at the top of the floating Shorts pill, half
  tucked behind it. A soft radial bloom (bright centre fading to transparent)
  plus a hairline ring, so it reads as a glowing disc rather than a flat dot.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="22dp"
                android:startColor="@color/cobalt_flare_core"
                android:centerColor="@color/cobalt_flare_mid"
                android:endColor="@color/cobalt_flare_edge" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/cobalt_flare_ring" />
        </shape>
    </item>
</layer-list>
