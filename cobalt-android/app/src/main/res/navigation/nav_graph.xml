<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.cobalt.android.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_library"
        android:name="com.cobalt.android.ui.library.LibraryFragment"
        android:label="@string/nav_library"
        tools:layout="@layout/fragment_library" />

    <fragment
        android:id="@+id/nav_shorts"
        android:name="com.cobalt.android.ui.shorts.ShortsFragment"
        android:label="@string/nav_shorts"
        tools:layout="@layout/fragment_shorts" />

    <fragment
        android:id="@+id/nav_me"
        android:name="com.cobalt.android.ui.me.MeFragment"
        android:label="@string/nav_me"
        tools:layout="@layout/fragment_me" />

    <fragment
        android:id="@+id/nav_browser"
        android:name="com.cobalt.android.ui.browser.BrowserFragment"
        android:label="@string/browser_title"
        tools:layout="@layout/fragment_browser" />

    <fragment
        android:id="@+id/nav_vault"
        android:name="com.cobalt.android.vault.VaultFragment"
        android:label="@string/vault_title"
        tools:layout="@layout/fragment_vault" />

    <fragment
        android:id="@+id/nav_media_library"
        android:name="com.cobalt.android.media.MediaLibraryFragment"
        android:label="@string/media_library_title"
        tools:layout="@layout/fragment_media_library" />

    <fragment
        android:id="@+id/nav_games"
        android:name="com.cobalt.android.ui.games.GamesFragment"
        android:label="@string/games_title"
        tools:layout="@layout/fragment_games" />

    <fragment
        android:id="@+id/nav_channel"
        android:name="com.cobalt.android.ui.channel.ChannelFragment"
        android:label="@string/channel_title"
        tools:layout="@layout/fragment_channel" />

    <fragment
        android:id="@+id/nav_status"
        android:name="com.cobalt.android.status.StatusFragment"
        android:label="@string/status_title"
        tools:layout="@layout/fragment_status" />

    <fragment
        android:id="@+id/nav_music"
        android:name="com.cobalt.android.ui.music.MusicFragment"
        android:label="@string/music_title"
        tools:layout="@layout/fragment_music" />

    <!-- Settings is reached from the Me tab (a VidMate-style row), not the
         bottom bar, so it has no bottom-nav menu item. -->
    <fragment
        android:id="@+id/nav_settings"
        android:name="com.cobalt.android.ui.settings.SettingsFragment"
        android:label="@string/nav_settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
