<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/cobalt_surface"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/qrImage"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:contentDescription="@string/qr_share"
        android:background="#FFFFFFFF" />

    <TextView
        android:id="@+id/qrLink"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/cobalt_text_secondary"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="middle" />

    <TextView
        android:id="@+id/qrClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:text="@string/action_close"
        android:textColor="@color/cobalt_accent_blue"
        android:textSize="14sp" />

</LinearLayout>
