<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000">

    <!-- Video surface. Playback is owned by the single shared ExoPlayer in
         ShortsFragment, attached to whichever page is active. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:resize_mode="zoom"
        app:use_controller="false"
        app:surface_type="texture_view" />

    <!-- Phase 24: per-item chrome (avatar, username, like/save/share with
         counts, caption, progress) is now Compose (ShortsChrome.kt),
         replacing the stock Android-API-1 system drawables the previous
         item_short_video.xml used. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/chromeCompose"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
