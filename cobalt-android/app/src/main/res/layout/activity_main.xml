<?xml version="1.0" encoding="utf-8"?>
<!--
  VidMate-style app shell: a full-bleed content host with a flat, black
  bottom navigation bar (blue selected item, no Material pill indicator) and
  a floating download-queue button. The per-screen search bar lives inside
  the Home composable, matching VidMate's per-tab chrome rather than a single
  global toolbar.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cobalt_background">

    <fragment
        android:id="@+id/navHost"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        tools:layout="@layout/fragment_home" />

    <!-- Floating download-queue entry point (VidMate keeps a persistent
         download affordance on top of every tab). -->
    <FrameLayout
        android:id="@+id/fabQueue"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="76dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_fab"
        android:clickable="true"
        android:focusable="true"
        android:elevation="6dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_download"
            android:contentDescription="@string/shortcut_open_queue" />

        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            android:visibility="gone"
            android:fontFamily="@font/ibm_plex_mono_regular" />

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/cobalt_surface_sidebar"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemTextColor="@color/bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
