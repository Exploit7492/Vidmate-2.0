<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      LIGHT palette (default). values-night/colors.xml carries the dark
      palette; Theme.Cobalt is a DayNight theme, so AppCompatDelegate's night
      mode (driven by SettingsRepository.ThemeMode via ThemeApplier) selects
      between the two. Brand blue/red are shared across both modes.
    -->
    <color name="cobalt_background">#FFFFFF</color>
    <color name="cobalt_surface">#F6F7F9</color>
    <color name="cobalt_surface_sidebar">#FFFFFF</color>
    <color name="cobalt_surface_elevated">#ECEEF1</color>
    <color name="cobalt_surface_card">#F1F3F6</color>
    <color name="cobalt_divider">#E2E5EA</color>
    <color name="cobalt_text_primary">#111418</color>
    <color name="cobalt_text_secondary">#5A6169</color>
    <color name="cobalt_text_tertiary">#8A9199</color>
    <color name="cobalt_accent_blue">#F5402E</color>
    <color name="cobalt_success_green">#2E9E3A</color>
    <color name="cobalt_error_red">#E0342F</color>
    <color name="cobalt_gold">#E0A800</color>
    <color name="cobalt_input_border">#CED3DA</color>
</resources>
